# ============================================================
# للتبريد والتكييف — environment template (PRD §3.4, Supabase edition)
# Copy to .env.local and fill in values. Never commit real secrets.
# ============================================================

# --- Site ---
# Canonical public URL, no trailing slash (used for SEO, sitemap, hreflang)
NEXT_PUBLIC_SITE_URL=https://riyadhacservice.site

# --- Supabase (CMS backend — content only, never bookings) ---
# Public config: safe to expose to the browser (protected by RLS).
# The NEW "sb_publishable_…" key or the legacy "anon public" JWT both work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. NEVER prefix with NEXT_PUBLIC_ — it bypasses Row Level Security.
# The new "sb_secret_…" secret key or the legacy service_role JWT.
# Used exclusively in src/lib/supabase/admin.ts (guarded by `import "server-only"`).
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin (single admin, Supabase Email/Password auth) ---
# The one allow-listed admin login email; every admin write is re-verified
# server-side against this value.
ADMIN_LOGIN_EMAIL=

# --- SEO ---
# Google Search Console verification meta token
NEXT_PUBLIC_GSC_VERIFICATION=
